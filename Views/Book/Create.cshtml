@model Bookify.Models.Book
@{
    ViewData["Title"] = "Nuevo Libro";
}

<div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
        <a asp-action="Index" class="text-muted hover:text-gold transition text-sm">← Volver</a>
        <span class="text-border">/</span>
        <span class="text-sm text-dark font-medium">Nuevo Libro</span>
    </div>

    <div class="bg-cream border border-border rounded-xl overflow-hidden">
        <div class="px-7 py-5 border-b border-border bg-sand">
            <h2 class="font-serif text-xl font-bold text-dark">Registrar Libro</h2>
            <p class="text-xs text-muted mt-1">Completa los campos para agregar un nuevo libro</p>
        </div>

        <form asp-action="Store" method="post" class="px-7 py-6">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-2 gap-5">

                <div class="flex flex-col gap-1.5 col-span-2">
                    <label asp-for="Title" class="text-xs tracking-widest text-muted uppercase"></label>
                    <input asp-for="Title" placeholder="Ej: Cien Años de Soledad"
                           class="bg-beige border border-border rounded-lg px-4 py-2.5 text-sm text-dark placeholder-muted focus:outline-none focus:border-gold transition" />
                    <span asp-validation-for="Title" class="text-xs text-red-500"></span>
                </div>

                <div class="flex flex-col gap-1.5 col-span-2">
                    <label asp-for="Author" class="text-xs tracking-widest text-muted uppercase"></label>
                    <input asp-for="Author" placeholder="Ej: Gabriel García Márquez"
                           class="bg-beige border border-border rounded-lg px-4 py-2.5 text-sm text-dark placeholder-muted focus:outline-none focus:border-gold transition" />
                    <span asp-validation-for="Author" class="text-xs text-red-500"></span>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="Isbn" class="text-xs tracking-widest text-muted uppercase"></label>
                    <input asp-for="Isbn" placeholder="978-0-00-000000-0"
                           class="bg-beige border border-border rounded-lg px-4 py-2.5 text-sm text-dark placeholder-muted focus:outline-none focus:border-gold transition" />
                    <span asp-validation-for="Isbn" class="text-xs text-red-500"></span>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="BookGenre" class="text-xs tracking-widest text-muted uppercase"></label>
                    <select asp-for="BookGenre" asp-items="Html.GetEnumSelectList<Bookify.Models.BookGenre>()"
                            class="bg-beige border border-border rounded-lg px-4 py-2.5 text-sm text-dark focus:outline-none focus:border-gold transition">
                        <option value="">Seleccionar género...</option>
                    </select>
                    <span asp-validation-for="BookGenre" class="text-xs text-red-500"></span>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="PublicationYear" class="text-xs tracking-widest text-muted uppercase"></label>
                    <input asp-for="PublicationYear" type="number" placeholder="Ej: 1967"
                           class="bg-beige border border-border rounded-lg px-4 py-2.5 text-sm text-dark placeholder-muted focus:outline-none focus:border-gold transition" />
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="Stock" class="text-xs tracking-widest text-muted uppercase"></label>
                    <input asp-for="Stock" type="number" min="1" placeholder="Ej: 5"
                           class="bg-beige border border-border rounded-lg px-4 py-2.5 text-sm text-dark placeholder-muted focus:outline-none focus:border-gold transition" />
                    <span asp-validation-for="Stock" class="text-xs text-red-500"></span>
                </div>

            </div>

            <div class="flex justify-end gap-3 mt-7 pt-5 border-t border-border">
                <a asp-action="Index"
                   class="text-sm px-5 py-2.5 rounded-lg border border-border text-muted hover:text-dark hover:border-dark transition">
                    Cancelar
                </a>
                <button type="submit"
                        class="bg-gold text-white text-sm font-medium px-6 py-2.5 rounded-lg hover:opacity-90 transition">
                    Registrar Libro
                </button>
            </div>
        </form>
    </div>
</div>
