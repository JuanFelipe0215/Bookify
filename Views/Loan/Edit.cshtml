@model Bookify.Models.Loan
@{
    ViewData["Title"] = "Editar Préstamo";
}

<div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
        <a asp-action="Index" class="text-muted hover:text-gold transition text-sm">← Volver</a>
        <span class="text-border">/</span>
        <span class="text-sm text-dark font-medium">Editar Préstamo</span>
    </div>

    <div class="bg-cream border border-border rounded-xl overflow-hidden">
        <div class="px-7 py-5 border-b border-border bg-sand">
            <h2 class="font-serif text-xl font-bold text-dark">Editar Préstamo</h2>
            <p class="text-xs text-muted mt-1">Actualiza el estado o la fecha de devolución</p>
        </div>

        <form asp-action="Update" method="post" class="px-7 py-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="LoanDate" />
            <input type="hidden" asp-for="IdUser" />
            <input type="hidden" asp-for="IdBook" />

            <div class="grid grid-cols-2 gap-5">

                <div class="flex flex-col gap-1.5 col-span-2">
                    <label class="text-xs tracking-widest text-muted uppercase">Usuario</label>
                    <div class="bg-sand border border-border rounded-lg px-4 py-2.5 text-sm text-muted">
                        @(Model.User != null ? $"{Model.User.FirstName} {Model.User.Lastname}" : "Usuario #" + Model.IdUser)
                    </div>
                </div>

                <div class="flex flex-col gap-1.5 col-span-2">
                    <label class="text-xs tracking-widest text-muted uppercase">Libro</label>
                    <div class="bg-sand border border-border rounded-lg px-4 py-2.5 text-sm text-muted">
                        @(Model.Book != null ? Model.Book.Title : "Libro #" + Model.IdBook)
                    </div>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="ReturnDate" class="text-xs tracking-widest text-muted uppercase">Fecha de Devolución</label>
                    <input asp-for="ReturnDate" type="date"
                           class="bg-beige border border-border rounded-lg px-4 py-2.5 text-sm text-dark focus:outline-none focus:border-gold transition" />
                </div>

                <div class="flex flex-col gap-1.5">
                    <label asp-for="Status" class="text-xs tracking-widest text-muted uppercase">Estado</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<Bookify.Models.StatusLoan>()"
                            class="bg-beige border border-border rounded-lg px-4 py-2.5 text-sm text-dark focus:outline-none focus:border-gold transition">
                    </select>
                </div>

            </div>

            <div class="flex justify-end gap-3 mt-7 pt-5 border-t border-border">
                <a asp-action="Index"
                   class="text-sm px-5 py-2.5 rounded-lg border border-border text-muted hover:text-dark hover:border-dark transition">
                    Cancelar
                </a>
                <button type="submit"
                        class="bg-gold text-white text-sm font-medium px-6 py-2.5 rounded-lg hover:opacity-90 transition">
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>
