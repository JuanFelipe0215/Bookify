@model Bookify.Models.Loan
@{
    ViewData["Title"] = "Detalle Préstamo";
}

<div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
        <a asp-action="Index" class="text-muted hover:text-gold transition text-sm">← Volver</a>
        <span class="text-border">/</span>
        <span class="text-sm text-dark font-medium">Detalle de Préstamo</span>
    </div>

    <div class="bg-cream border border-border rounded-xl overflow-hidden">
        <div class="px-7 py-5 border-b border-border bg-sand flex items-center justify-between">
            <div>
                <h2 class="font-serif text-xl font-bold text-dark">Préstamo #@Model.Id</h2>
                <p class="text-xs text-muted mt-1">Registrado el @Model.LoanDate.ToString("dd/MM/yyyy")</p>
            </div>
            <div class="flex items-center gap-2">
                @if (Model.Status == Bookify.Models.StatusLoan.Prestado)
                {
                    <span class="text-xs px-2.5 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-700">Prestado</span>
                }
                else if (Model.Status == Bookify.Models.StatusLoan.Devuelto)
                {
                    <span class="text-xs px-2.5 py-1 rounded-full bg-green-50 border border-green-200 text-green-700">Devuelto</span>
                }
                else
                {
                    <span class="text-xs px-2.5 py-1 rounded-full bg-red-50 border border-red-200 text-red-600">Vencido</span>
                }
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="text-xs px-4 py-2 rounded-lg border border-border text-muted hover:text-gold hover:border-gold transition">
                    Editar
                </a>
            </div>
        </div>

        <div class="px-7 py-6 grid grid-cols-2 gap-6">
            <div class="col-span-2">
                <p class="text-xs tracking-widest text-muted uppercase mb-1">Usuario</p>
                <p class="text-sm text-dark font-medium">
                    @(Model.User != null ? $"{Model.User.FirstName} {Model.User.Lastname}" : "—")
                </p>
            </div>
            <div class="col-span-2">
                <p class="text-xs tracking-widest text-muted uppercase mb-1">Libro</p>
                <p class="text-sm text-dark font-medium">
                    @(Model.Book != null ? Model.Book.Title : "—")
                </p>
            </div>
            <div>
                <p class="text-xs tracking-widest text-muted uppercase mb-1">Fecha de Préstamo</p>
                <p class="text-sm text-dark font-medium">@Model.LoanDate.ToString("dd/MM/yyyy")</p>
            </div>
            <div>
                <p class="text-xs tracking-widest text-muted uppercase mb-1">Fecha de Devolución</p>
                <p class="text-sm text-dark font-medium">
                    @(Model.ReturnDate.HasValue ? Model.ReturnDate.Value.ToString("dd/MM/yyyy") : "Pendiente")
                </p>
            </div>
        </div>

        <div class="px-7 py-5 border-t border-border flex justify-end gap-3">
            <a asp-action="Index"
               class="text-sm px-5 py-2.5 rounded-lg border border-border text-muted hover:text-dark transition">
                Volver
            </a>
            <form asp-action="Destroy" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="IdUser" />
                <input type="hidden" asp-for="IdBook" />
                <input type="hidden" asp-for="LoanDate" />
                <input type="hidden" asp-for="Status" />
                <button type="submit"
                        onclick="return confirm('¿Estás seguro de eliminar este préstamo?')"
                        class="text-sm px-5 py-2.5 rounded-lg bg-red-50 border border-red-200 text-red-600 hover:bg-red-100 transition">
                    Eliminar Préstamo
                </button>
            </form>
        </div>
    </div>
</div>
