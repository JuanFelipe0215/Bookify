@model IEnumerable<Bookify.Models.Loan>
@{
    ViewData["Title"] = "Préstamos";
}

@if (TempData["message"] != null)
{
    <div class="mb-4 px-4 py-3 rounded-lg bg-amber-50 border border-amber-200 text-amber-800 text-sm">
        @TempData["message"]
    </div>
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="font-serif text-2xl font-bold text-dark">Préstamos</h1>
        <p class="text-sm text-muted mt-1">Gestiona los préstamos activos y el historial</p>
    </div>
    <a asp-action="Create"
       class="bg-gold text-white text-sm font-medium px-5 py-2.5 rounded-lg hover:opacity-90 transition">
        + Nuevo Préstamo
    </a>
</div>

<div class="bg-cream border border-border rounded-xl overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b border-border bg-sand">
        <span class="text-xs tracking-widest text-muted uppercase">Historial de Préstamos</span>
        <span class="text-xs text-muted">@Model.Count() registros</span>
    </div>
    <table class="w-full">
        <thead>
            <tr class="bg-sand border-b border-border">
                <th class="text-left px-5 py-3 text-xs tracking-widest text-muted uppercase">#</th>
                <th class="text-left px-5 py-3 text-xs tracking-widest text-muted uppercase">Usuario</th>
                <th class="text-left px-5 py-3 text-xs tracking-widest text-muted uppercase">Libro</th>
                <th class="text-left px-5 py-3 text-xs tracking-widest text-muted uppercase">Fecha Préstamo</th>
                <th class="text-left px-5 py-3 text-xs tracking-widest text-muted uppercase">Devolución</th>
                <th class="text-left px-5 py-3 text-xs tracking-widest text-muted uppercase">Estado</th>
                <th class="text-left px-5 py-3 text-xs tracking-widest text-muted uppercase">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in Model)
            {
                <tr class="border-b border-border hover:bg-sand transition-colors">
                    <td class="px-5 py-4 text-sm text-muted">@loan.Id</td>
                    <td class="px-5 py-4 text-sm font-medium text-dark">
                        @(loan.User != null ? $"{loan.User.FirstName} {loan.User.Lastname}" : "—")
                    </td>
                    <td class="px-5 py-4 text-sm text-dark">
                        @(loan.Book != null ? loan.Book.Title : "—")
                    </td>
                    <td class="px-5 py-4 text-sm text-muted">@loan.LoanDate.ToString("dd/MM/yyyy")</td>
                    <td class="px-5 py-4 text-sm text-muted">
                        @(loan.ReturnDate.HasValue ? loan.ReturnDate.Value.ToString("dd/MM/yyyy") : "Pendiente")
                    </td>
                    <td class="px-5 py-4">
                        @if (loan.Status == Bookify.Models.StatusLoan.Prestado)
                        {
                            <span class="text-xs px-2.5 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-700">Prestado</span>
                        }
                        else if (loan.Status == Bookify.Models.StatusLoan.Devuelto)
                        {
                            <span class="text-xs px-2.5 py-1 rounded-full bg-green-50 border border-green-200 text-green-700">Devuelto</span>
                        }
                        else
                        {
                            <span class="text-xs px-2.5 py-1 rounded-full bg-red-50 border border-red-200 text-red-600">Vencido</span>
                        }
                    </td>
                    <td class="px-5 py-4">
                        <div class="flex gap-2">
                            <a asp-action="Show" asp-route-id="@loan.Id"
                               class="text-xs px-3 py-1.5 rounded-md border border-border text-muted hover:text-gold hover:border-gold transition">
                                Ver
                            </a>
                            <a asp-action="Edit" asp-route-id="@loan.Id"
                               class="text-xs px-3 py-1.5 rounded-md border border-border text-muted hover:text-gold hover:border-gold transition">
                                Editar
                            </a>
                            <a asp-action="Delete" asp-route-id="@loan.Id"
                               class="text-xs px-3 py-1.5 rounded-md border border-border text-muted hover:text-red-500 hover:border-red-400 transition">
                                Eliminar
                            </a>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="px-5 py-12 text-center text-muted text-sm">
                        No hay préstamos registrados aún.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
