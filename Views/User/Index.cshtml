@model IEnumerable<Bookify.Models.User>
@{
    ViewData["Title"] = "Usuarios";
}

@if (TempData["message"] != null)
{
    <div class="mb-4 px-4 py-3 rounded-lg bg-amber-50 border border-amber-200 text-amber-800 text-sm">
        @TempData["message"]
    </div>
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="font-serif text-2xl font-bold text-dark">Usuarios</h1>
        <p class="text-sm text-muted mt-1">Gestiona los usuarios registrados</p>
    </div>
    <a asp-action="Create"
       class="bg-gold text-white text-sm font-medium px-5 py-2.5 rounded-lg hover:opacity-90 transition">
        + Nuevo Usuario
    </a>
</div>

<div class="bg-cream border border-border rounded-xl overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b border-border bg-sand">
        <span class="text-xs tracking-widest text-muted uppercase">Lista de Usuarios</span>
        <span class="text-xs text-muted">@Model.Count() registros</span>
    </div>
    <table class="w-full">
        <thead>
            <tr class="bg-sand border-b border-border">
                <th class="text-left px-5 py-3 text-xs tracking-widest text-muted uppercase">#</th>
                <th class="text-left px-5 py-3 text-xs tracking-widest text-muted uppercase">Nombre</th>
                <th class="text-left px-5 py-3 text-xs tracking-widest text-muted uppercase">Email</th>
                <th class="text-left px-5 py-3 text-xs tracking-widest text-muted uppercase">Teléfono</th>
                <th class="text-left px-5 py-3 text-xs tracking-widest text-muted uppercase">Registro</th>
                <th class="text-left px-5 py-3 text-xs tracking-widest text-muted uppercase">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr class="border-b border-border hover:bg-sand transition-colors">
                    <td class="px-5 py-4 text-sm text-muted">@user.Id</td>
                    <td class="px-5 py-4 text-sm font-medium text-dark">@user.FirstName @user.Lastname</td>
                    <td class="px-5 py-4 text-sm text-muted">@user.Email</td>
                    <td class="px-5 py-4 text-sm text-muted">@user.PhoneNumber</td>
                    <td class="px-5 py-4 text-sm text-muted">@user.DateRegistration.ToString("dd/MM/yyyy")</td>
                    <td class="px-5 py-4">
                        <div class="flex gap-2">
                            <a asp-action="Show" asp-route-id="@user.Id"
                               class="text-xs px-3 py-1.5 rounded-md border border-border text-muted hover:text-gold hover:border-gold transition">
                                Ver
                            </a>
                            <a asp-action="Edit" asp-route-id="@user.Id"
                               class="text-xs px-3 py-1.5 rounded-md border border-border text-muted hover:text-gold hover:border-gold transition">
                                Editar
                            </a>
                            <a asp-action="Delete" asp-route-id="@user.Id"
                               class="text-xs px-3 py-1.5 rounded-md border border-border text-muted hover:text-red-500 hover:border-red-400 transition">
                                Eliminar
                            </a>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="px-5 py-12 text-center text-muted text-sm">
                        No hay usuarios registrados aún.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
