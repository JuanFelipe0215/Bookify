@model Bookify.Models.User
@{
    ViewData["Title"] = "Detalle Usuario";
}

<div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
        <a asp-action="Index" class="text-muted hover:text-gold transition text-sm">← Volver</a>
        <span class="text-border">/</span>
        <span class="text-sm text-dark font-medium">Detalle de Usuario</span>
    </div>

    <div class="bg-cream border border-border rounded-xl overflow-hidden">
        <div class="px-7 py-5 border-b border-border bg-sand flex items-center justify-between">
            <div>
                <h2 class="font-serif text-xl font-bold text-dark">@Model.FirstName @Model.Lastname</h2>
                <p class="text-xs text-muted mt-1">Registrado el @Model.DateRegistration.ToString("dd/MM/yyyy")</p>
            </div>
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="text-xs px-4 py-2 rounded-lg border border-border text-muted hover:text-gold hover:border-gold transition">
                Editar
            </a>
        </div>

        <div class="px-7 py-6 grid grid-cols-2 gap-6">
            <div>
                <p class="text-xs tracking-widest text-muted uppercase mb-1">Nombre</p>
                <p class="text-sm text-dark font-medium">@Model.FirstName</p>
            </div>
            <div>
                <p class="text-xs tracking-widest text-muted uppercase mb-1">Apellido</p>
                <p class="text-sm text-dark font-medium">@Model.Lastname</p>
            </div>
            <div class="col-span-2">
                <p class="text-xs tracking-widest text-muted uppercase mb-1">Email</p>
                <p class="text-sm text-dark font-medium">@Model.Email</p>
            </div>
            <div class="col-span-2">
                <p class="text-xs tracking-widest text-muted uppercase mb-1">Teléfono</p>
                <p class="text-sm text-dark font-medium">@(Model.PhoneNumber ?? "No registrado")</p>
            </div>
        </div>

        <div class="px-7 py-5 border-t border-border flex justify-end gap-3">
            <a asp-action="Index"
               class="text-sm px-5 py-2.5 rounded-lg border border-border text-muted hover:text-dark transition">
                Volver
            </a>
            <form asp-action="Destroy" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FirstName" />
                <input type="hidden" asp-for="Lastname" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="PhoneNumber" />
                <button type="submit"
                        onclick="return confirm('¿Estás seguro de eliminar este usuario?')"
                        class="text-sm px-5 py-2.5 rounded-lg bg-red-50 border border-red-200 text-red-600 hover:bg-red-100 transition">
                    Eliminar Usuario
                </button>
            </form>
        </div>
    </div>
</div>
